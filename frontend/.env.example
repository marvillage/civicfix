# Origin of the Fixity API — no trailing slash, no /api suffix.
# Local development:
VITE_API_URL=http://localhost:5000

# Production example (set this in Vercel > Settings > Environment Variables):
# VITE_API_URL=https://fixity-api.onrender.com

# Static demo with no backend: every API call is answered from the
# recorded sample data in src/demo.
# VITE_DEMO=1
