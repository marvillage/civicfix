# Copy to .env and fill in. The server validates these at boot and
# exits with a readable list if something required is missing.

# Required
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/fixity
JWT_SECRET=replace-with-a-long-random-string-of-16-plus-characters

# Server
PORT=5000
# Comma-separated allow-list; unset = allow any origin (development)
# CORS_ORIGIN=https://fixity.example.com
# Used for share-page redirects
FRONTEND_URL=http://localhost:5173

# Rate limits (defaults shown)
# RATE_LIMIT_AUTH=30      # login/register attempts per 15 min per IP
# RATE_LIMIT_WRITES=120   # writes per minute per IP

# Photo and voice-note storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AutoSort (photo classification)
GEMINI_API_KEY=

# Optional email mirror of in-app alerts
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=

# Integration tests (npm test) run against this scratch database
# TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/fixity_test
